{
  "name": "sokin-qa-assignment",
  "version": "1.0.0",
  "description": "Mobile QA take-home: test strategy, exploratory report, and a scalable WebdriverIO + Appium automation framework for the automationexercise.com app (web reference for a hypothetical native iOS/Android app).",
  "type": "module",
  "scripts": {
    "test:web": "wdio run ./config/wdio.web.conf.ts",
    "test:web:headed": "HEADED=1 wdio run ./config/wdio.web.conf.ts",
    "test:android": "wdio run ./config/wdio.android.conf.ts",
    "test:ios": "wdio run ./config/wdio.ios.conf.ts",
    "typecheck": "tsc --noEmit",
    "pdf": "node scripts/md2pdf.mjs",
    "docx": "node scripts/md2docx.mjs"
  },
  "keywords": [
    "qa",
    "mobile",
    "appium",
    "webdriverio",
    "typescript",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "html-to-docx": "^1.8.0",
    "marked": "^18.0.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.0"
  }
}
